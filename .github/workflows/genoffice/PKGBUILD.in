# Generated by genoffice-archlinux-workflow from an immutable upstream commit.
pkgname=genoffice
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc=@DESCRIPTION@
arch=('x86_64')
url=@URL@
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'pacman' 'polkit' 'alsa-lib' 'at-spi2-core' 'cairo'
         'cups' 'dbus' 'expat' 'glib2' 'gtk3' 'libdrm' 'libnotify' 'libsecret'
         'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
         'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango'
         'systemd-libs' 'xdg-utils')
makedepends=('rust' 'nodejs' 'npm' 'git' 'pkgconf' 'python' 'desktop-file-utils')
optdepends=('ttf-carlito: metric-compatible Calibri document font'
            'ttf-caladea: metric-compatible Cambria document font'
            'noto-fonts-cjk: CJK document font coverage')
options=('!lto' '!debug' '!strip')
_commit=@SHA@
_upstream_version=@UPSTREAM_VERSION@
_build_date=@BUILD_DATE@
_arch_repo=@REPOSITORY@
source=(@SOURCES@)
sha256sums=(@CHECKSUMS@)

_build_env() {
  export CARGO_TARGET_DIR="$startdir/.cache/target"
  export CARGO_HOME="$startdir/.cache/cargo"
  export CARGO_BUILD_JOBS="${GENOFFICE_BUILD_JOBS:-2}"
  export CARGO_PROFILE_RELEASE_DEBUG=0
  export RUSTFLAGS='-C target-cpu=x86-64'
  export npm_config_cache="$startdir/.cache/npm"
  export npm_config_audit=false
  export npm_config_fund=false
  export ELECTRON_CACHE="$startdir/.cache/electron"
  export ELECTRON_BUILDER_CACHE="$startdir/.cache/electron-builder"
  export GENOFFICE_APP_VERSION="$_upstream_version"
}

prepare() {
  cd "$srcdir/genoffice-$_commit"
  python "$startdir/patch_updater.py" apps/shell/src/main/updater.ts "$_arch_repo"
}

build() {
  cd "$srcdir/genoffice-$_commit"
  _build_env
  npm ci --no-audit --no-fund
  npm run notices
  npm run build:all
  install -Dm755 "$CARGO_TARGET_DIR/release/xlsx-sidecar" \
    apps/sheets/native/xlsx-engine/target/release/xlsx-sidecar
  (
    cd apps/shell
    npx --no-install electron-builder --linux dir --x64 \
      -c.extraMetadata.version="$_upstream_version"
  )
}

check() {
  cd "$srcdir/genoffice-$_commit"
  _build_env
  test -x apps/shell/release/linux-unpacked/genoffice
  test -x apps/shell/release/linux-unpacked/resources/native/xlsx-sidecar
  test -x apps/shell/release/linux-unpacked/resources/cli/genoffice
  apps/shell/release/linux-unpacked/resources/cli/genoffice --version
  apps/shell/release/linux-unpacked/resources/cli/genoffice --help >/dev/null
}

package() {
  cd "$srcdir/genoffice-$_commit"
  _build_env
  local size file

  install -d "$pkgdir/opt/GenOffice"
  cp -a apps/shell/release/linux-unpacked/. "$pkgdir/opt/GenOffice/"
  chmod 755 "$pkgdir/opt/GenOffice/genoffice" \
    "$pkgdir/opt/GenOffice/resources/cli/genoffice" \
    "$pkgdir/opt/GenOffice/resources/native/xlsx-sidecar"
  if [[ -f "$pkgdir/opt/GenOffice/chrome-sandbox" ]]; then
    chmod 4755 "$pkgdir/opt/GenOffice/chrome-sandbox"
  fi
  printf '{"repository":"%s","pkgver":"%s","pkgrel":%s,"version":"%s-%s","commit":"%s"}\n' \
    "$_arch_repo" "$pkgver" "$pkgrel" "$pkgver" "$pkgrel" "$_commit" \
    > "$pkgdir/opt/GenOffice/resources/arch-release.json"
  chmod 644 "$pkgdir/opt/GenOffice/resources/arch-release.json"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/GenOffice/resources/cli/genoffice "$pkgdir/usr/bin/genoffice"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/genoffice.desktop" <<'DESKTOP'
[Desktop Entry]
Name=GenOffice
Comment=AI-native office suite for Docs, Sheets, Slides, PDF, Markdown, and HTML
Exec=/opt/GenOffice/genoffice %U
Terminal=false
Type=Application
Icon=genoffice
StartupWMClass=genoffice
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-excel;text/csv;text/tab-separated-values;application/vnd.oasis.opendocument.spreadsheet;application/vnd.oasis.opendocument.spreadsheet-template;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.text-template;application/vnd.oasis.opendocument.presentation;application/vnd.oasis.opendocument.presentation-template;application/pdf;text/markdown;text/plain;application/json;text/html;
Categories=Office;
DESKTOP
  desktop-file-validate "$pkgdir/usr/share/applications/genoffice.desktop"

  for size in 16x16 32x32 48x48 64x64 128x128 256x256 512x512 1024x1024; do
    install -Dm644 "apps/shell/build/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/genoffice.png"
  done

  if [[ -f packaging/flatpak/com.genoffice.app.metainfo.xml ]]; then
    install -d "$pkgdir/usr/share/metainfo"
    sed 's/com\.genoffice\.app\.desktop/genoffice.desktop/g' \
      packaging/flatpak/com.genoffice.app.metainfo.xml \
      > "$pkgdir/usr/share/metainfo/com.genoffice.app.metainfo.xml"
  fi

  for file in LICENSE LICENSE-UNICODE.txt NOTICE; do
    [[ ! -f "$file" ]] || install -Dm644 "$file" "$pkgdir/usr/share/licenses/$pkgname/$file"
  done
  install -Dm644 apps/shell/build/THIRD-PARTY-NOTICES.txt \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  [[ ! -f README.md ]] || install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
